{
	"schemaVersion": 1,
	"id": "tickpilot",
	"version": "${version}",
	"name": "TickPilot",
	"description": "Measures server tick cost, explains it in plain language, and cautiously throttles optional work.",
	"authors": [
		"babycoded"
	],
	"license": "MIT",
	"icon": "assets/tickpilot/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.tickpilot.TickPilot"
		],
		"client": [
			"com.tickpilot.client.TickPilotClient"
		]
	},
	"mixins": [
		"tickpilot.mixins.json",
		{
			"config": "tickpilot.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}